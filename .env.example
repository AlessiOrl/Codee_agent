POSTGRES_USER=agent
POSTGRES_PASSWORD=change_me_agent_password
POSTGRES_DB=agent_db
TELEGRAM_BOT_TOKEN=change_me_telegram_bot_token

AGENT_API_KEY=change_me_agent_api_key
AGENT_API_URL=http://agent-api:8000
DATABASE_URL=postgresql://agent:change_me_agent_password@postgres:5432/agent_db
QDRANT_URL=http://qdrant:6333

OPENWEBUI_BASE_URL=http://host.docker.internal:6969
OPENWEBUI_API_KEY=change_me_openwebui_token
OPENWEBUI_MODEL=set_later
OPENWEBUI_FALLBACK_MODEL=
OPENWEBUI_USE_WEB_SEARCH=false
OPENWEBUI_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=hash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDINGS_BASE_URL=http://host.docker.internal:11434
OLLAMA_STATUS_TIMEOUT_SECONDS=4
EMBEDDING_MODEL=
USE_LOCAL_HASH_EMBEDDINGS=true
VECTOR_SIZE=384

SYSTEM_PROMPT=You are Codee, a private assistant. Answer clearly, practically, and in a friendly tone.
RECENT_HISTORY_LIMIT=20
SUMMARY_EVERY_N_MESSAGES=12
MAX_DOCUMENT_CHARS=200000
